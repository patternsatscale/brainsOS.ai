# ==============================================================================
# brainsOS: Platform Cloud Infrastructure Environment Configuration
# Template file - NEVER commit production secrets or domain names to Git.
# ==============================================================================

# Route 53 & Split-Horizon DNS Configuration
BRAINSOS_ZONE_NAME=example.com
BRAINSOS_SUBDOMAIN=brainsos
BRAINSOS_CREATE_ZONE=false
BRAINSOS_REDIRECT_URL=https://brainsos.ai

# Environment Stage Parameterization (e.g. 'osx' for testing laptop, 'dgx' for appliance)
BRAINSOS_STAGE=osx

# Simple Email Service (SES) Domains (comma-separated, domain identities & Easy DKIM)
SES_DOMAINS=example.com

# Multi-Environment Inbound Email Domain Override
# Configure custom email domain per environment (e.g., osx.example.com vs dgx.example.com)
BRAINSOS_EMAIL_DOMAIN=osx.example.com
