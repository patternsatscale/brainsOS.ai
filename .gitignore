# Environment & Secrets
.env
*.env
!.env.example

# Explicitly ensure config templates are tracked
!config/memories/**

# Live Agent Memories (Keep root gitkeep, live notes remain git-ignored)
data/memories/*
!data/memories/.gitkeep

# Snapshots, Runtime State & Backups
data/backups/
data/control_plane/
*.tar.gz

# Local Volume Mounts & Caches
data/litellm_db/
data/postgres/
ollama_data/
.cache/
tmp/
.venv/
venv/
__pycache__/

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
/logs/
