{
	admin off
	auto_https disable_redirects
	# Clients connecting by bare IP send no SNI; serve the primary site certificate.
	default_sni {$BRAINSOS_DOMAIN:localhost}
	fallback_sni {$BRAINSOS_DOMAIN:localhost}
}

# ==============================================================================
# brainsOS: Appliance TLS Modes (Tickets #312 / #323)
# Selected at parse time by BRAINSOS_TLS_MODE (written to .env by firstboot.sh
# or scripts/control/set-domain.sh):
#   internal (default) - Caddy internal CA (self-signed). Works on any hostname/IP.
#   acme               - Bring-your-own-domain: public ACME (TLS-ALPN-01 on 443 or
#                        HTTP-01 on 80). Falls back to the internal CA if issuance
#                        fails, so HTTPS never goes down.
#   route53            - BYOD via Route 53 DNS-01 using the EC2 instance role
#                        (no static AWS credentials). Same internal-CA fallback.
# Every tls_* snippet is reachable through `import tls_{$BRAINSOS_TLS_MODE}`.
# ==============================================================================
(tls_internal) {
	tls internal
}

(tls_acme) {
	tls {
		issuer acme {
			email {$ACME_EMAIL}
		}
		issuer internal
	}
}

(tls_route53) {
	tls {
		issuer acme {
			email {$ACME_EMAIL}
			dns route53
			propagation_delay 30s
			propagation_timeout 3m
			resolvers 1.1.1.1 8.8.8.8
		}
		issuer internal
	}
}

# ==============================================================================
# Authentik Identity Provider & Forward Auth Gateway Snippets
# ==============================================================================
(authentik_forward_auth) {
	forward_auth authentik-server:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username Remote-User X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt Remote-Email
		trusted_proxies private_ranges
		@outpost_warming status 404 502 503 504
		handle_response @outpost_warming {
			error 503
		}
		@outpost_zero_host {
			status 302
			header Location *0.0.0.0*
		}
		handle_response @outpost_zero_host {
			error 503
		}
	}
}

(firstboot_portal_auth_true) {
	import authentik_forward_auth
}

(firstboot_portal_auth_false) {
	request_header X-BrainsOS-Prelogin-Wizard "true"
}

(system_api_auth_true) {
	forward_auth authentik-server:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username Remote-User X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt Remote-Email
		trusted_proxies private_ranges
		@outpost_non2xx status 302 401 403 404 502 503 504
		handle_response @outpost_non2xx {
			request_header X-Authentik-Outpost-Fallback "true"
		}
	}
}

(system_api_auth_false) {
	request_header X-BrainsOS-Prelogin-Wizard "true"
}

(authentik_backend) {
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy authentik-server:9000 {
		flush_interval -1
	}
}

(hermes_runner_backend) {
	import authentik_forward_auth
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy runner-hermes:9119 {
		header_up Remote-User {header.Remote-User}
		header_up X-Authentik-Username {header.X-Authentik-Username}
		header_down -x-frame-options
		header_down -content-security-policy
		flush_interval -1
	}
}

# ==============================================================================
# BrainsOS Thin-Spine React Portal SPA Content
# ==============================================================================
(portal_content) {
	encode gzip zstd
	root * /srv/portal
	try_files {path} /index.html
	file_server
}

(langfuse_proxy) {
	reverse_proxy {$LANGFUSE_UPSTREAM:langfuse-web:3000} {
		header_down -x-frame-options
		header_down -content-security-policy
		flush_interval -1
	}
}

# ==============================================================================
# Core Ingress Routing Engine (Single-Origin Port 443 Invariant)
# ==============================================================================
(unified_ingress) {
	encode gzip zstd
	log {
		output stdout
		format console
	}

	# --------------------------------------------------------------------------
	# PLANE 2: Programmatic LiteLLM API Gateway (Direct Token Auth, No SSO)
	# --------------------------------------------------------------------------
	@proxy_host header_regexp Host (?i)^proxy\.
	handle @proxy_host {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	@proxy_api_path path /proxy/v1/* /v1/*
	handle @proxy_api_path {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			flush_interval -1
		}
	}

	# --------------------------------------------------------------------------
	# PLANE 3: Mail Ingress & Groupware Sync (MX, CalDAV, CardDAV, ActiveSync)
	# --------------------------------------------------------------------------
	@mail_static {
		header_regexp Host (?i)^mail\.
		path /SOGo.woa/WebServerResources/* /SOGo/WebServerResources/* /WebServerResources/*
	}
	handle @mail_static {
		reverse_proxy sogo:20000 {
			header_down -x-frame-options
			flush_interval -1
		}
	}

	@mail_host header_regexp Host (?i)^mail\.
	handle @mail_host {
		import authentik_forward_auth
		redir /.well-known/caldav /SOGo/dav/ 301
		redir /.well-known/carddav /SOGo/dav/ 301
		@mail_host_root path /
		redir @mail_host_root /SOGo 302
		reverse_proxy sogo:20000 {
			header_up x-webobjects-remote-user {header.X-Authentik-Username}
			header_up Remote-User {header.X-Authentik-Username}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_up x-webobjects-server-name {host}
			header_up x-webobjects-server-port {server_port}
			header_up x-webobjects-server-url https://{host}
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# --------------------------------------------------------------------------
	# Observability Platform (Host: langfuse.*) - requires BYOD + wildcard DNS.
	# Langfuse cannot be served under a sub-path, so bare-IP appliances have no
	# browser route to the Langfuse UI (ingestion is in-network and unaffected).
	# --------------------------------------------------------------------------
	@langfuse_host header_regexp Host (?i)^langfuse\.
	handle @langfuse_host {
		reverse_proxy {$LANGFUSE_UPSTREAM:langfuse-web:3000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# --------------------------------------------------------------------------
	# PLANE 1: Single-Origin Web Portal & Authentik SSO Ingress
	# --------------------------------------------------------------------------

	# A. Authentik SSO Endpoints & Outposts
	handle /healthz {
		respond "OK" 200
	}
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik-server:9000 {
			header_down Location "^https?://0\.0\.0\.0(:[0-9]+)?(/.*)$" "https://{host}$2"
		}
	}
	handle /auth/* {
		uri strip_prefix /auth
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
		}
	}
	handle /flows/* {
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
			header_down -content-security-policy
		}
	}
	handle /if/* {
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
			header_down -content-security-policy
		}
	}
	handle /media/* {
		reverse_proxy authentik-server:9000
	}
	handle /-/* {
		reverse_proxy authentik-server:9000
	}
	handle /static/* {
		reverse_proxy authentik-server:9000
	}

	# Subsystem: System Telemetry & Universal Update Engine API (Ticket #310 / #311)
	@system_public_status {
		method GET
		path /api/v1/system/jobs/* /api/v1/system/jobs-active /api/v1/system/health /api/v1/system/identity /api/v1/system/status /api/v1/system/csrf
	}
	handle @system_public_status {
		reverse_proxy host.docker.internal:{$BRAINSOS_SYSTEM_API_PORT:8010} {
			header_up X-BrainsOS-Internal {$SYSTEM_API_TOKEN}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			flush_interval -1
		}
	}

	handle /api/v1/system/* {
		import system_api_auth_{$BRAINSOS_WIZARD_COMPLETED:true}
		reverse_proxy host.docker.internal:{$BRAINSOS_SYSTEM_API_PORT:8010} {
			header_up X-BrainsOS-Internal {$SYSTEM_API_TOKEN}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_up X-Authentik-Email {header.X-Authentik-Email}
			header_up Remote-User {header.Remote-User}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			flush_interval -1
		}
	}

	@litellm_api_subpaths path /api/plugins /api/plugins/* /api/event_logging/*
	handle @litellm_api_subpaths {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy authentik-server:9000
	}
	handle /application/* {
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
			header_down -content-security-policy
		}
	}
	handle /ws/* {
		reverse_proxy authentik-server:9000
	}

	# B. Subsystem 1: Operator Studio (VS Code IDE)
	@editor_no_slash path /editor
	redir @editor_no_slash /editor/ 308
	handle /editor/* {
		import authentik_forward_auth
		uri strip_prefix /editor
		reverse_proxy code-server:8443 {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# B2. Subsystem 1b: Source Control (Local Gitea Git Server) (Ticket #340)
	@git_no_slash path /git
	redir @git_no_slash /git/ 308
	handle /git/* {
		@git_reserved_admin header_regexp X-Authentik-Username ^(admin|akadmin)$
		route {
			import authentik_forward_auth
			request_header @git_reserved_admin X-Authentik-Username operator
			uri strip_prefix /git
			reverse_proxy gitea:3000 {
				header_up X-Authentik-Username {header.X-Authentik-Username}
				header_up X-Authentik-Email {header.X-Authentik-Email}
				header_up X-Authentik-Name {header.X-Authentik-Name}
				header_down -x-frame-options
				header_down -content-security-policy
				flush_interval -1
			}
		}
	}

	# C. Subsystem 2: Communications Plane (SOGo Webmail & Groupware)
	@sogo_static path /SOGo.woa/WebServerResources/* /SOGo/WebServerResources/* /WebServerResources/*
	handle @sogo_static {
		reverse_proxy sogo:20000 {
			header_down -x-frame-options
			flush_interval -1
		}
	}

	@mail_path path /mail /mail/
	redir @mail_path /SOGo 302
	handle /SOGo* {
		import authentik_forward_auth
		reverse_proxy sogo:20000 {
			header_up x-webobjects-remote-user {header.X-Authentik-Username}
			header_up Remote-User {header.X-Authentik-Username}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_up x-webobjects-server-name {host}
			header_up x-webobjects-server-port {server_port}
			header_up x-webobjects-server-url https://{host}
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# D. Subsystem 3: Control Plane Admin UI (LiteLLM Admin Console)
	@proxy_ui_defaults path /proxy /proxy/ /proxy/ui /proxy/ui/ /ui
	redir @proxy_ui_defaults /sso/key/generate 302
	handle /proxy/ui/* {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /ui/* {
		@ui_entry_needs_sso {
			method GET
			path /ui/
			not query login=success
			not query page=*
			not header_regexp Referer /ui/
		}
		redir @ui_entry_needs_sso /sso/key/generate 302
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /sso/* {
		uri path_regexp ^(/sso/.+?)(?:\.(?:txt|rsc)|/)$ $1
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/sso/* {
		uri strip_prefix /proxy
		uri path_regexp ^(/sso/.+?)(?:\.(?:txt|rsc)|/)$ $1
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /litellm-asset-prefix/* {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /.well-known/litellm-ui-config {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /litellm/.well-known/litellm-ui-config {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/.well-known/litellm-ui-config {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/litellm/.well-known/litellm-ui-config {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	@litellm_api path \
 /key /key/* \
 /model /model/* /models /models* /model_group /model_group/* /model_hub /model_hub/* \
 /user /user/* \
 /team /team/* \
 /customer /customer/* \
 /spend /spend/* \
 /global /global/* \
 /health /health/* \
 /routes /routes* \
 /config /config/* \
 /service_account /service_account/* \
 /public /public/* \
 /settings /settings/* \
 /get /get/* \
 /update /update/* \
 /add /add/* \
 /delete /delete/* \
 /tag /tag/* \
 /gateway /gateway/* \
 /audit /audit/* \
 /router /router/* \
 /cache /cache/* \
 /coordination_redis /coordination_redis/* \
 /cost /cost/* /cost_optimization /cost_optimization/* \
 /email /email/* \
 /project/new /project/update /project/delete /project/info /project/list \
 /budget /budget/* \
 /invitation /invitation/* \
 /alerting /alerting/* \
 /organization/new /organization/update /organization/delete /organization/info /organization/list /organization/member_add /organization/member_update /organization/member_delete \
 /auto_router /auto_router/* \
 /access_group /access_group/* \
 /guardrails /guardrails/* \
 /policies /policies/* /policy /policy/* \
 /prompts /prompts/* \
 /search_tools /search_tools/* \
 /mcp-rest /mcp-rest/* \
 /vector_store /vector_store/* \
 /rag /rag/* \
 /callbacks /callbacks/* \
 /credentials /credentials/* \
 /fallback /fallback/* \
 /activity /activity/* \
 /agent /agent/* \
 /onboarding /onboarding/* \
 /session /session/* \
 /utils /utils/* \
 /compliance /compliance/* \
 /claude-code /claude-code/* \
 /reload /reload/* \
 /schedule /schedule/* \
 /v1 /v1/* \
 /v2 /v2/* \
 /v3 /v3/* \
 /v1beta /v1beta/* \
 /openai /openai/* /openai_passthrough /openai_passthrough/* \
 /chat /chat/* \
 /completions /completions/* \
 /embeddings /embeddings/* \
 /batches /batches/* \
 /files /files/* \
 /threads /threads/* \
 /assistants /assistants/* \
 /audio /audio/* \
 /images /images/* \
 /responses /responses/* \
 /realtime /realtime/* \
 /a2a /a2a/* \
 /scim /scim/* \
 /management /management/* \
 /login \
 /active /active/* \
 /adaptive_router /adaptive_router/* \
 /apply_guardrail \
 /config_overrides /config_overrides/* \
 /containers /containers/* \
 /decisions \
 /end_user /end_user/* \
 /fine_tuning /fine_tuning/* \
 /interactions /interactions/* \
 /jwt /jwt/* \
 /lens /lens/* \
 /liteadmin /liteadmin/* \
 /live /live/* \
 /mcp /mcp/* \
 /model-insights /model-insights/* \
 /moderations \
 /ocr \
 /otel-spans \
 /plugin-proxy /plugin-proxy/* \
 /provider /provider/* \
 /rerank \
 /search /search/* \
 /telemetry /telemetry/* \
 /toolset /toolset/* \
 /upload /upload/* \
 /usage /usage/* \
 /vector_stores /vector_stores/* \
 /videos /videos/* \
 /openapi.json /get_favicon /get_image /get_logo_url /get_cache_settings
	handle @litellm_api {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/* {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# Future-proof catch-all for any new endpoint called by the LiteLLM Admin UI (/ui/*)
	@litellm_ui_referer {
		header_regexp Referer ^https?://[^/]+/(proxy/)?ui(/|$|\?)
		not path /ui/* /proxy/* /sso/* /litellm-asset-prefix/* /.well-known/* /litellm/* /application/* /flows/* /if/* /outpost.goauthentik.io/* /auth/* /static/* /media/* /-/* /ws/* /api/v1/system/* /editor/* /git/* /SOGo* /efw/* /runner* /dgx* /_next/* /project/brainsos* /project/~* /organization/brainsos* /trace/* /api/trpc/* /api/auth/*
	}
	handle @litellm_ui_referer {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# E. Subsystem 4: Tool Egress Gateway & Inspection Console (mitmweb)
	@efw_no_slash path /efw
	redir @efw_no_slash /efw/ 308
	handle /efw/* {
		import authentik_forward_auth
		uri strip_prefix /efw
		reverse_proxy tool-egress-proxy:8081 {
			header_up Authorization "Bearer {$TOOL_EGRESS_WEB_PASSWORD:brainsos_tool_egress_secret}"
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# F. Subsystem 5: Observability Plane (Langfuse Single-Origin & Subdomain Ingress)
	@langfuse_root path /langfuse /langfuse/
	handle @langfuse_root {
		redir /project/brainsos/sessions 302
	}
	@langfuse_subpath path /langfuse/*
	handle @langfuse_subpath {
		uri strip_prefix /langfuse
		redir {uri} 302
	}
	handle /_next/* {
		import langfuse_proxy
	}
	handle /icon.svg {
		import langfuse_proxy
	}
	handle /icon256.png {
		import langfuse_proxy
	}
	handle /icon512.png {
		import langfuse_proxy
	}
	handle /wordart-black.svg {
		import langfuse_proxy
	}
	handle /wordart-white.svg {
		import langfuse_proxy
	}
	handle /fonts/* {
		import langfuse_proxy
	}
	handle /generated/* {
		import langfuse_proxy
	}
	handle /trace/* {
		import langfuse_proxy
	}
	handle /project/brainsos* {
		import langfuse_proxy
	}
	handle /project/~* {
		import langfuse_proxy
	}
	handle /organization/brainsos* {
		import langfuse_proxy
	}
	handle /api/trpc/* {
		import langfuse_proxy
	}
	handle /api/auth/* {
		import langfuse_proxy
	}
	handle /api/public/* {
		import langfuse_proxy
	}
	handle /api/project/* {
		import langfuse_proxy
	}
	handle /api/traces/* {
		import langfuse_proxy
	}
	handle /api/dashboard/* {
		import langfuse_proxy
	}
	handle /api/chatCompletion* {
		import langfuse_proxy
	}
	handle /api/admin/* {
		import langfuse_proxy
	}
	handle /api/internal/* {
		import langfuse_proxy
	}
	handle /auth/sign-in* {
		import langfuse_proxy
	}
	handle /auth/error* {
		import langfuse_proxy
	}
	handle /auth/sso-initiate* {
		import langfuse_proxy
	}
	handle /auth/reset-password* {
		import langfuse_proxy
	}
	handle /auth/setup-password* {
		import langfuse_proxy
	}
	handle /auth/sign-up* {
		import langfuse_proxy
	}
	handle /auth/enterprise-sso-required* {
		import langfuse_proxy
	}
	handle /account/settings* {
		import langfuse_proxy
	}

	# G. Subsystem 6: Agent Plane (Hermes Runner WebUI)
	@runner_no_slash path /runner
	redir @runner_no_slash /runner/ 308
	handle /runner* {
		import authentik_forward_auth
		uri strip_prefix /runner
		reverse_proxy runner-hermes:9119 {
			header_up X-Forwarded-Prefix /runner
			header_up Remote-User {header.Remote-User}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# H. Subsystem 7: Hardware Telemetry (NVIDIA DGX Dashboard)
	handle /dgx* {
		import authentik_forward_auth
		reverse_proxy host.docker.internal:11001 {
			header_down -x-frame-options
			flush_interval -1
		}
	}

	# I. Subsystem 8: Documentation & Architectural Matrix
	@docs_path path /docs /docs/*
	handle @docs_path {
		import authentik_forward_auth
		import portal_content
	}

	# Subsystem 9a: Internal CA root certificate download for operator trust (#323).
	# Public certificate material only; gated by SSO (or pre-login firstboot wizard).
	handle /system/ca.crt {
		import firstboot_portal_auth_{$BRAINSOS_WIZARD_COMPLETED:true}
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=brainsos-root-ca.crt"
		file_server
	}

	# Subsystem 9: System Manager & Update Center Web Subsystem (Ticket #311)
	@system_path path /system /system/*
	handle @system_path {
		import firstboot_portal_auth_{$BRAINSOS_WIZARD_COMPLETED:true}
		import portal_content
	}

	# J. Default Handler: BrainsOS Thin-Spine React Portal SPA
	handle {
		import firstboot_portal_auth_{$BRAINSOS_WIZARD_COMPLETED:true}
		import portal_content
	}

	# Cold-Boot Splash Page: Shown while authentik-server / control plane containers
	# complete initial database migrations on first boot (replaces raw 502/503/504).
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store, no-cache, must-revalidate"
		respond <<HTML
			<!DOCTYPE html>
			<html lang="en">
			<head>
			  <meta charset="utf-8" />
			  <meta name="viewport" content="width=device-width, initial-scale=1" />
			  <meta http-equiv="refresh" content="4" />
			  <title>brainsOS Appliance • Initializing</title>
			  <style>
			    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #090d16; color: #e2e8f0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace; }
			    .card { max-width: 460px; padding: 32px; border-radius: 12px; background: #111827; border: 1px solid #1e293b; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
			    .spinner { width: 36px; height: 36px; margin: 0 auto 20px; border: 3px solid #1e293b; border-top-color: #14b8a6; border-radius: 50%; animation: spin 1s linear infinite; }
			    @keyframes spin { to { transform: rotate(360deg); } }
			    h1 { font-size: 18px; margin: 0 0 10px; color: #f8fafc; letter-spacing: 0.02em; }
			    p { font-size: 13px; line-height: 1.6; color: #94a3b8; margin: 0; }
			    .badge { display: inline-block; margin-top: 16px; padding: 4px 10px; font-size: 11px; border-radius: 9999px; background: rgba(20,184,166,0.12); color: #2dd4bf; border: 1px solid rgba(20,184,166,0.3); }
			  </style>
			</head>
			<body>
			  <div class="card">
			    <div class="spinner"></div>
			    <h1>brainsOS Appliance Initializing</h1>
			    <p>First-boot identity &amp; control plane services are starting up.<br/>This page will automatically redirect to Sign In in a few seconds...</p>
			    <div class="badge">Auto-refreshing every 4s</div>
			  </div>
			</body>
			</html>
			HTML 503
	}
}

# ==============================================================================
# Port 80 Listener: Strict HTTP -> HTTPS 301 Permanent Redirect
# Enforces the Single-Origin Port 443 Invariant across all external requests.
# ==============================================================================
:80 {
	redir https://{host}{uri} 301
}

# ==============================================================================
# HTTPS Listeners (Single-Origin Port 443 Invariant)
# Explicit site addresses so certificates are issued for real names only.
# ==============================================================================

# Primary hostname (EC2 public DNS by default, or the operator's own domain).
{$BRAINSOS_DOMAIN:localhost} {
	import tls_{$BRAINSOS_TLS_MODE:internal}
	import unified_ingress
}

# Subdomain planes (langfuse., proxy., mail.). Only resolvable with BYOD +
# wildcard DNS; in ACME modes a failed issuance falls back to the internal CA.
langfuse.{$BRAINSOS_DOMAIN:localhost}, proxy.{$BRAINSOS_DOMAIN:localhost}, mail.{$BRAINSOS_DOMAIN:localhost} {
	import tls_{$BRAINSOS_TLS_MODE:internal}
	import unified_ingress
}

# Bare-IP access (public/private IPv4 written by firstboot.sh). Public CAs do
# not issue for these, so they always use the internal CA. Redirects to the
# canonical primary hostname so Authentik / OIDC Host headers always match.
{$BRAINSOS_IP_SITES:127.0.0.1} {
	import tls_internal
	@not_primary not host {$BRAINSOS_DOMAIN:localhost}
	redir @not_primary https://{$BRAINSOS_DOMAIN:localhost}{uri} 302
	import unified_ingress
}
