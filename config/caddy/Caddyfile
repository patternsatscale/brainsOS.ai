{
	# Disable automatic HTTPS for private local domains (.local / .localhost)
	auto_https off
	admin off
}

# ==============================================================================
# Agent Plane Gateway
# ==============================================================================
http://hermes.{$TITAN_DOMAIN:titan.local}, http://hermes.localhost {
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy hermes:8642 {
		# Flush immediately for streaming responses / SSE
		flush_interval -1
	}
}

# ==============================================================================
# Control Plane Gateway (LiteLLM)
# ==============================================================================
http://proxy.{$TITAN_DOMAIN:titan.local}, http://proxy.localhost {
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy litellm:4000 {
		flush_interval -1
	}
}

# ==============================================================================
# Memory Plane Gateway (SilverBullet PKM)
# ==============================================================================
http://memory.{$TITAN_DOMAIN:titan.local}, http://memory.localhost {
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy silverbullet:3000
}

# ==============================================================================
# Ingress Default / Healthcheck Landing Page
# ==============================================================================
:80 {
	respond <<HTML
