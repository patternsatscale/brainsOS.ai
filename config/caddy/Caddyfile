  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var hostname = window.location.hostname;
      var protocol = window.location.protocol;
      if (hostname !== "localhost" && hostname !== "127.0.0.1") {
        var isTitanLocal = hostname.indexOf("titan.local") !== -1;
        var domain = isTitanLocal ? hostname : "{$TITAN_DOMAIN:titan.local}";
        var cards = document.querySelectorAll("a.card[data-subdomain]");
        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          var sub = card.getAttribute("data-subdomain");
          var path = card.getAttribute("data-path") || "";
          card.href = protocol + "//" + sub + "." + domain + path;
          var primary = card.querySelector(".primary-link");
          if (primary) {
            primary.textContent = sub + "." + domain + path;
          }
        }
      }
    });
  </script>
