# ==============================================================================
# Agent Plane Gateway: Hermes Web Dashboard (Port 9119)
# ==============================================================================
http://hermes.{$TITAN_DOMAIN:titan.local}, https://hermes.{$TITAN_DOMAIN:titan.local}, http://hermes.localhost, https://hermes.localhost {
	tls internal
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy hermes:9119 {
		flush_interval -1
	}
}


# ==============================================================================
# Control Plane Gateway (LiteLLM)
# ==============================================================================
http://proxy.{$TITAN_DOMAIN:titan.local}, https://proxy.{$TITAN_DOMAIN:titan.local}, http://proxy.localhost, https://proxy.localhost {
	tls internal
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy host.docker.internal:4000 {
		flush_interval -1
	}
}

# ==============================================================================
# Memory Plane Gateway (SilverBullet PKM)
# ==============================================================================
http://memory.{$TITAN_DOMAIN:titan.local}, https://memory.{$TITAN_DOMAIN:titan.local}, http://memory.localhost, https://memory.localhost {
	tls internal
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy silverbullet:3000
}

# ==============================================================================
# Hardware Telemetry Gateway (NVIDIA DGX Dashboard)
# ==============================================================================
http://dgx.{$TITAN_DOMAIN:titan.local}, https://dgx.{$TITAN_DOMAIN:titan.local}, http://dgx.localhost, https://dgx.localhost {
	tls internal
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy host.docker.internal:11001 {
		flush_interval -1
	}
}

