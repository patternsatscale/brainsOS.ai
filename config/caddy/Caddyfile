# Public / Appliance Domain Site Block (*.local.brainsos.ai, custom domains)
http://{$BRAINSOS_DOMAIN:brainsos.local}, https://{$BRAINSOS_DOMAIN:brainsos.local}, http://*.{$BRAINSOS_DOMAIN:brainsos.local}, https://*.{$BRAINSOS_DOMAIN:brainsos.local}, http://local.brainsos.ai, https://local.brainsos.ai, http://*.local.brainsos.ai, https://*.local.brainsos.ai {
	import brainsos_tls
	import unified_ingress
}

# Localhost Fallback Site Block (:80, :443, localhost, *.localhost)
http://localhost, https://localhost, http://*.localhost, https://*.localhost, :80, :443 {
	tls internal
	import unified_ingress
}

# ==============================================================================
# Backward Compatibility: Dedicated Subdomain Site Blocks
# ==============================================================================
(hermes_runner_backend) {
	import authentik_forward_auth
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy runner-hermes:8787 {
		header_up Remote-User {header.Remote-User}
		header_up X-Authentik-Username {header.X-Authentik-Username}
		flush_interval -1
	}
}

http://auth.{$BRAINSOS_DOMAIN:brainsos.local}, https://auth.{$BRAINSOS_DOMAIN:brainsos.local} {
	import brainsos_tls
	import authentik_backend
}

http://auth.localhost, https://auth.localhost {
	tls internal
	import authentik_backend
}

http://hermes.runner.{$BRAINSOS_DOMAIN:brainsos.local}, https://hermes.runner.{$BRAINSOS_DOMAIN:brainsos.local} {
	import brainsos_tls
	import hermes_runner_backend
}

http://hermes.runner.localhost, https://hermes.runner.localhost {
	tls internal
	import hermes_runner_backend
}

