{
	admin off
	auto_https disable_redirects
}

# ==============================================================================
# brainsOS: TLS Policy Snippet
# ==============================================================================
import tls_policy.caddy

# ==============================================================================
# Authentik Identity Provider & Forward Auth Gateway Snippets
# ==============================================================================
(authentik_forward_auth) {
	forward_auth authentik-server:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username Remote-User X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt Remote-Email
		trusted_proxies private_ranges
	}
}

(authentik_backend) {
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy authentik-server:9000 {
		flush_interval -1
	}
}

# ==============================================================================
# BrainsOS Thin-Spine React Portal SPA Content
# ==============================================================================
(portal_content) {
	encode gzip zstd
	root * /srv/portal
	try_files {path} /index.html
	file_server
}

# ==============================================================================
# Core Ingress Routing Engine
# Handles:
#   1. Programmatic API mapping (Host: proxy.* or path /proxy/v1/*)
#   2. Mail & Groupware Sync (Host: mail.* or path /mail*)
#   3. Authentik SSO Gateway & Outposts
#   4. Authenticated Subsystems (/editor, /efw, /langfuse, /runner, /dgx, /proxy/ui)
#   5. Default Thin-Spine Portal Shell (/)
# ==============================================================================
(unified_ingress) {
	encode gzip zstd
	log {
		output stdout
		format console
	}

	# --------------------------------------------------------------------------
	# PLANE 2: Programmatic LiteLLM API Gateway (Direct Token Auth, No SSO)
	# Matches any host starting with proxy. (e.g. proxy.local.brainsos.ai,
	# proxy.osx.local.brainsos.ai) OR direct API paths (/v1/*, /proxy/v1/*).
	# Preserves caller's Authorization header (Rule 9 tenant virtual keys).
	# --------------------------------------------------------------------------
	@proxy_host header_regexp Host (?i)^proxy\.
	handle @proxy_host {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	@proxy_api_path path /proxy/v1/* /v1/*
	handle @proxy_api_path {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			flush_interval -1
		}
	}

	# --------------------------------------------------------------------------
	# PLANE 3: Mail Ingress & Groupware Sync (MX, CalDAV, CardDAV, ActiveSync)
	# Matches any host starting with mail. (e.g. mail.local.brainsos.ai)
	# --------------------------------------------------------------------------
	@mail_host header_regexp Host (?i)^mail\.
	handle @mail_host {
		import authentik_forward_auth
		redir /.well-known/caldav /SOGo/dav/ 301
		redir /.well-known/carddav /SOGo/dav/ 301
		@mail_host_root path /
		redir @mail_host_root /SOGo 302
		reverse_proxy sogo:20000 {
			header_up x-webobjects-remote-user {header.X-Authentik-Username}
			header_up Remote-User {header.X-Authentik-Username}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_up x-webobjects-server-name {host}
			header_up x-webobjects-server-port {server_port}
			header_up x-webobjects-server-url https://{host}
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# --------------------------------------------------------------------------
	# Observability Platform (Host: langfuse.*)
	# Matches any host starting with langfuse. (e.g. langfuse.local.brainsos.ai,
	# langfuse.osx.local.brainsos.ai). Direct reverse proxy with framing enabled
	# for portal embedding and unblocked trace ingestion.
	# --------------------------------------------------------------------------
	@langfuse_host header_regexp Host (?i)^langfuse\.
	handle @langfuse_host {
		reverse_proxy {$LANGFUSE_UPSTREAM:host.docker.internal:3001} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# --------------------------------------------------------------------------
	# PLANE 1: Single-Origin Web Portal & Authentik SSO Ingress
	# --------------------------------------------------------------------------

	# A. Authentik SSO Endpoints & Outposts (Public & Internal Flow Routes)
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik-server:9000
	}
	handle /auth/* {
		uri strip_prefix /auth
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
		}
	}
	handle /flows/* {
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
			header_down -content-security-policy
		}
	}
	handle /if/* {
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
			header_down -content-security-policy
		}
	}
	handle /media/* {
		reverse_proxy authentik-server:9000
	}
	handle /-/* {
		reverse_proxy authentik-server:9000
	}
	handle /static/* {
		reverse_proxy authentik-server:9000
	}
	handle /api/* {
		reverse_proxy authentik-server:9000
	}
	handle /application/* {
		reverse_proxy authentik-server:9000 {
			header_down -x-frame-options
			header_down -content-security-policy
		}
	}
	handle /ws/* {
		reverse_proxy authentik-server:9000
	}

	# B. Subsystem 1: Operator Studio (VS Code IDE)
	@editor_no_slash path /editor
	redir @editor_no_slash /editor/ 308
	handle /editor/* {
		import authentik_forward_auth
		uri strip_prefix /editor
		reverse_proxy code-server:8443 {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# C. Subsystem 2: Communications Plane (SOGo Webmail & Groupware)
	@sogo_static path /SOGo.woa/WebServerResources/* /SOGo/WebServerResources/* /WebServerResources/*
	handle @sogo_static {
		reverse_proxy sogo:20000 {
			header_down -x-frame-options
			flush_interval -1
		}
	}

	@mail_path path /mail /mail/
	redir @mail_path /SOGo 302
	handle /SOGo* {
		import authentik_forward_auth
		reverse_proxy sogo:20000 {
			header_up x-webobjects-remote-user {header.X-Authentik-Username}
			header_up Remote-User {header.X-Authentik-Username}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_up x-webobjects-server-name {host}
			header_up x-webobjects-server-port {server_port}
			header_up x-webobjects-server-url https://{host}
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# D. Subsystem 3: Control Plane Admin UI (LiteLLM Admin Console)
	@proxy_ui_defaults path /proxy /proxy/ /proxy/ui /proxy/ui/ /ui
	redir @proxy_ui_defaults /ui/ 308
	handle /proxy/ui/* {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /ui/* {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /sso/* {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/sso/* {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /litellm-asset-prefix/* {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /.well-known/litellm-ui-config {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /litellm/.well-known/litellm-ui-config {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/.well-known/litellm-ui-config {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	handle /proxy/litellm/.well-known/litellm-ui-config {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	@litellm_api path /key* /model* /models* /user* /team* /customer* /organization* /project* /provider* /tag* /spend* /global* /health* /routes* /config* /service_account* /public* /settings* /update* /utils* /get_favicon /get_logo_url /get_image /v2/* /v3/*
	handle @litellm_api {
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}
	@proxy_litellm_api path /proxy/key* /proxy/model* /proxy/models* /proxy/user* /proxy/team* /proxy/customer* /proxy/organization* /proxy/project* /proxy/provider* /proxy/tag* /proxy/spend* /proxy/global* /proxy/health* /proxy/routes* /proxy/config* /proxy/service_account* /proxy/public* /proxy/settings* /proxy/update* /proxy/utils* /proxy/get_favicon /proxy/get_logo_url /proxy/get_image /proxy/v2/* /proxy/v3/*
	handle @proxy_litellm_api {
		uri strip_prefix /proxy
		reverse_proxy {$LITELLM_UPSTREAM:litellm:4000} {
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# E. Subsystem 4: Tool Egress Gateway & Inspection Console (mitmweb)
	@efw_no_slash path /efw
	redir @efw_no_slash /efw/ 308
	handle /efw/* {
		import authentik_forward_auth
		uri strip_prefix /efw
		reverse_proxy tool-egress-proxy:8081 {
			header_up Authorization "Bearer {$TOOL_EGRESS_WEB_PASSWORD:brainsos_tool_egress_secret}"
			header_down -x-frame-options
			header_down -content-security-policy
			flush_interval -1
		}
	}

	# F. Subsystem 5: Observability Plane (Langfuse)
	# Redirect /langfuse* to dedicated subdomain langfuse.{host} with subpath preserved
	# Default target is /project/brainsos/sessions
	@langfuse_root path /langfuse /langfuse/
	handle @langfuse_root {
		redir https://langfuse.{host}/project/brainsos/sessions 302
	}
	@langfuse_subpath path /langfuse/*
	handle @langfuse_subpath {
		uri strip_prefix /langfuse
		redir https://langfuse.{host}{uri} 302
	}

	# G. Subsystem 6: Agent Plane (Hermes Runner WebUI)
	handle /runner* {
		import authentik_forward_auth
		reverse_proxy runner-hermes:8787 {
			header_up Remote-User {header.Remote-User}
			header_up X-Authentik-Username {header.X-Authentik-Username}
			header_down -x-frame-options
			flush_interval -1
		}
	}

	# H. Subsystem 7: Hardware Telemetry (NVIDIA DGX Dashboard)
	handle /dgx* {
		import authentik_forward_auth
		reverse_proxy host.docker.internal:11001 {
			header_down -x-frame-options
			flush_interval -1
		}
	}

	# I. Subsystem 8: Documentation & Architectural Matrix
	@docs_path path /docs /docs/*
	handle @docs_path {
		import authentik_forward_auth
		import portal_content
	}

	# J. Default Handler: BrainsOS Thin-Spine React Portal SPA
	handle {
		import authentik_forward_auth
		import portal_content
	}
}

# ==============================================================================
# Site Listeners
# ==============================================================================

# Public / Appliance Domain Site Block (*.local.brainsos.ai, custom domains)
http://{$BRAINSOS_DOMAIN:brainsos.local}, https://{$BRAINSOS_DOMAIN:brainsos.local}, http://*.{$BRAINSOS_DOMAIN:brainsos.local}, https://*.{$BRAINSOS_DOMAIN:brainsos.local}, http://local.brainsos.ai, https://local.brainsos.ai, http://*.local.brainsos.ai, https://*.local.brainsos.ai {
	import brainsos_tls
	import unified_ingress
}

# Localhost Fallback Site Block (:80, :443, localhost, *.localhost)
http://localhost, https://localhost, http://*.localhost, https://*.localhost, :80, :443 {
	tls internal
	import unified_ingress
}

# ==============================================================================
# Backward Compatibility: Dedicated Subdomain Site Blocks
# ==============================================================================
(hermes_runner_backend) {
	import authentik_forward_auth
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy runner-hermes:8787 {
		header_up Remote-User {header.Remote-User}
		header_up X-Authentik-Username {header.X-Authentik-Username}
		flush_interval -1
	}
}

http://auth.{$BRAINSOS_DOMAIN:brainsos.local}, https://auth.{$BRAINSOS_DOMAIN:brainsos.local} {
	import brainsos_tls
	import authentik_backend
}

http://auth.localhost, https://auth.localhost {
	tls internal
	import authentik_backend
}

http://hermes.runner.{$BRAINSOS_DOMAIN:brainsos.local}, https://hermes.runner.{$BRAINSOS_DOMAIN:brainsos.local} {
	import brainsos_tls
	import hermes_runner_backend
}

http://hermes.runner.localhost, https://hermes.runner.localhost {
	tls internal
	import hermes_runner_backend
}

