# ------------------------------------------------------------------------------
# Agent Unit: Terrastella - Primary Operations Agent (terrastella) - Dashboard & Console
# ------------------------------------------------------------------------------
http://terrastella.titan.local.patternsatscale.com, https://terrastella.titan.local.patternsatscale.com {
	import titan_tls
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy titan-agent-terrastella:9119 {
		flush_interval -1
	}
}

http://terrastella.localhost, https://terrastella.localhost, http://terrastella.titan.local, https://terrastella.titan.local {
	tls internal
	encode gzip zstd
	log {
		output stdout
		format console
	}
	reverse_proxy titan-agent-terrastella:9119 {
		flush_interval -1
	}
}

