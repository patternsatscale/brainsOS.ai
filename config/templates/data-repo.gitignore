# ==============================================================================
# brainsOS Private Fleet Repository - Git Ignore Rules
# ==============================================================================

# --- Ephemeral Database & Locking State ---
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3

# --- Control Plane & IPC ---
control_plane/*.pid
control_plane/*.sock
control_plane/*.lock
control_plane/caddy_root.crt
control_plane/litellm_db/**
control_plane/vscode_config/**
control_plane/vscode_data/**
litellm_db/**

# --- Mail Spool & Transients ---
comms/spool/*
!comms/spool/.gitkeep
comms/maildir/*
!comms/maildir/.gitkeep
comms/email/**
comms/sogo/**
comms/signal/**

# --- Telemetry & Analytics Store ---
telemetry/*.log
telemetry/clickhouse/**
telemetry/redis/**
telemetry/minio/**
telemetry/postgres/**

# --- Backups ---
backups/*.tar.gz
backups/*.tgz
backups/*.zip
!backups/.gitkeep
!backups/*.sh
!backups/README.md

# --- Hermes Runner Ephemeral Runtime & Caches ---
runners/hermes/lazy-packages/
runners/hermes/skills/
runners/hermes/cache/
runners/hermes/audio_cache/
runners/hermes/image_cache/
runners/hermes/logs/
runners/hermes/sessions/
runners/hermes/cron/
runners/hermes/state/
runners/hermes/kanban/
runners/hermes/home/
runners/hermes/sandboxes/
runners/hermes/platforms/
runners/hermes/pairing/
runners/hermes/pending_messages/
runners/hermes/plans/
runners/hermes/memories/
runners/hermes/skins/
runners/hermes/workspace/
runners/hermes/backups/
runners/hermes/bin/
runners/hermes/hooks/
runners/hermes/*.lock
runners/hermes/.*.lock
runners/hermes/*.pid
runners/hermes/*.sock
runners/hermes/*.log
runners/hermes/*.bak*
runners/hermes/.*.bak*
runners/hermes/.env*
runners/hermes/install_id*
runners/hermes/.install_id*
runners/hermes/gateway_state.json
runners/hermes/channel_directory.json
runners/hermes/spawn-ledger.json
runners/hermes/.skills_prompt_snapshot.json
runners/hermes/.mcp-discovery.lock
runners/hermes/.tirith-install-failed
runners/hermes/mail_probe.py
runners/hermes/SOUL.md

# --- OS / Editor Artifacts ---
.DS_Store
Thumbs.db
*.tmp

