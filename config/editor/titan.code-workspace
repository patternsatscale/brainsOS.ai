{
  "folders": [
    {
      "name": "Project Titan (Repository)",
      "path": "/workspace/project-titan"
    },
    {
      "name": "Memory Plane (OKF Markdown)",
      "path": "/memories"
    },
    {
      "name": "Agent Workspaces (State & Logs)",
      "path": "/data/workspace"
    },
    {
      "name": "Cindy Pawford (App Canvas)",
      "path": "/apps/cindypawford/site"
    }
  ],
  "settings": {
    "telemetry.telemetryLevel": "off",
    "workbench.startupEditor": "none",
    "files.autoSave": "afterDelay",
    "terminal.integrated.defaultProfile.linux": "bash",
    "files.exclude": {
      "**/.git": false,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.vscode": false
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/data/litellm_db": true,
      "**/data/postgres": true
    },
    "foam.openDailyNote.directory": "daily-notes",
    "foam.openDailyNote.filenameFormat": "yyyy-mm-dd",
    "foam.openDailyNote.fileExtension": "md"
  }
}
