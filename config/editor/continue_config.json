{
  "name": "Titan Operator IDE",
  "version": "1.0.0",
  "schema": "v1",
  "models": [
    {
      "name": "Titan Core (LiteLLM)",
      "provider": "openai",
      "model": "titan-core",
      "apiBase": "http://litellm:4000/v1",
      "apiKey": "${OPERATOR_LITELLM_KEY}",
      "roles": [
        "chat",
        "edit",
        "apply"
      ]
    },
    {
      "name": "Terrastella (Agent API)",
      "provider": "openai",
      "model": "hermes-agent",
      "apiBase": "http://api.terrastella.titan.local/v1",
      "apiKey": "${API_SERVER_KEY}",
      "roles": [
        "chat"
      ]
    },
    {
      "name": "Marvin (Agent API)",
      "provider": "openai",
      "model": "hermes-agent",
      "apiBase": "http://api.marvin.titan.local/v1",
      "apiKey": "${API_SERVER_KEY}",
      "roles": [
        "chat"
      ]
    },
    {
      "name": "Bawtford (Agent API)",
      "provider": "openai",
      "model": "hermes-agent",
      "apiBase": "http://api.bawtford.titan.local/v1",
      "apiKey": "${API_SERVER_KEY}",
      "roles": [
        "chat"
      ]
    }
  ]
}
