{
  "folders": [
    {
      "name": "brainsOS (Repository)",
      "path": "/workspace/brainsos"
    },
    {
      "name": "Memory Plane (OKF Markdown)",
      "path": "/memories"
    },
    {
      "name": "Agent Workspaces (State & Logs)",
      "path": "/data/workspace"
    },
    {
      "name": "Communications Gateways (Signal & Email)",
      "path": "/data/comms"
    },
    {
      "name": "Cindy Pawford (App Canvas)",
      "path": "/data/agent_apps/cindypawford/site"
    }
  ],
  "settings": {
    "security.workspace.trust.enabled": false,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.emptyWindow": true,
    "http.proxyStrictSSL": false,
    "telemetry.telemetryLevel": "off",
    "workbench.startupEditor": "none",
    "files.autoSave": "afterDelay",
    "terminal.integrated.defaultProfile.linux": "bash",
    "files.exclude": {
      "**/.git": false,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/.vscode": false
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/data/litellm_db": true,
      "**/data/postgres": true,
      "**/data/langfuse_*": true,
      "**/data/langfuse_clickhouse": true,
      "**/data/langfuse_postgres": true,
      "**/data/telemetry": true,
      "**/data/control_plane/litellm_db": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.cache/**": true,
      "**/data/litellm_db/**": true,
      "**/data/postgres/**": true,
      "**/data/langfuse_*/**": true,
      "**/data/langfuse_clickhouse/**": true,
      "**/data/langfuse_postgres/**": true,
      "**/data/control_plane/**": true,
      "**/data/control_plane/litellm_db/**": true,
      "**/data/workspace/**": true,
      "**/data/agent_workspaces/**": true,
      "**/data/comms/**": true,
      "**/data/telemetry/**": true,
      "**/.venv/**": true,
      "**/dist/**": true,
      "**/build/**": true
    },
    "foam.openDailyNote.directory": "daily-notes",
    "foam.openDailyNote.filenameFormat": "yyyy-mm-dd",
    "foam.openDailyNote.fileExtension": "md"
  }
}
