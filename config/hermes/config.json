{
  "agent": {
    "name": "hermes-titan",
    "version": "1.0.0",
    "description": "Project Titan Autonomous Agent Instance"
  },
  "llm": {
    "provider": "openai_compatible",
    "base_url": "http://litellm:4000/v1",
    "model": "titan-core",
    "api_key_env": "HERMES_LITELLM_KEY",
    "temperature": 0.2,
    "max_tokens": 4096
  },
  "memory": {
    "format": "OKF",
    "storage_path": "/memories",
    "rules": {
      "format_only": "markdown",
      "disallowed_content": [
        "binary_files",
        "sqlite_databases",
        "python_packages",
        "cache_directories"
      ],
      "structure": {
        "knowledge": "/memories/knowledge",
        "rules": "/memories/rules",
        "logs": "/memories/logs"
      }
    }
  },
  "workspace": {
    "path": "/workspace",
    "description": "Internal sandbox for runtime packages, tools, caches, and local databases"
  },
  "capabilities": {
    "shell_enabled": true,
    "browser_enabled": true,
    "signal_enabled": true,
    "network_egress": true
  }
}
