#!/usr/bin/env bash
# ==============================================================================
# brainsos-chat: Instant CLI Interface to brainsOS Fleet Agents
# Dispatches user prompts directly to Hermes agent containers with tools & memory
# ==============================================================================
set -euo pipefail

AGENT="${1:-}"
shift || true
PROMPT="$*"

if [ -z "${AGENT}" ] || [ -z "${PROMPT}" ]; then
  echo "Usage: brainsos-chat <agent-name> <message>"
  echo "Available agents: terrastella, marvin, bawtford"
  exit 1
fi

case "${AGENT}" in
  terrastella)
    API_URL="http://api.terrastella.brainsos.local/v1/chat/completions"
    FALLBACK_URL="http://host.docker.internal:8642/v1/chat/completions"
    AUTH_KEY="${HERMES_API_TERRASTELLA_KEY:-}"
    MODEL="hermes-agent"
    ;;
  marvin)
    API_URL="http://api.marvin.brainsos.local/v1/chat/completions"
    FALLBACK_URL="http://host.docker.internal:8643/v1/chat/completions"
    AUTH_KEY="${HERMES_API_MARVIN_KEY:-}"
    MODEL="hermes-agent"
    ;;
  bawtford)
    API_URL="http://api.bawtford.brainsos.local/v1/chat/completions"
    FALLBACK_URL="http://host.docker.internal:8644/v1/chat/completions"
    AUTH_KEY="${HERMES_API_BAWTFORD_KEY:-}"
    MODEL="hermes-agent"
    ;;
  *)
    echo "Unknown agent: ${AGENT}"
    exit 1
    ;;
esac

TARGET_URL="${API_URL}"
# Check if API_URL resolves, otherwise fall back to host-gateway port
if ! curl -s -m 2 -o /dev/null -w "%{http_code}" "${API_URL%/chat/completions}/models" >/dev/null 2>&1; then
  TARGET_URL="${FALLBACK_URL}"
fi

echo "Connecting to ${AGENT} via ${TARGET_URL}..."
curl -s -X POST "${TARGET_URL}" \
  -H "Authorization: Bearer ${AUTH_KEY}" \
  -H "Content-Type: application/json" \
  -d "$(jq -n --arg model "${MODEL}" --arg content "${PROMPT}" '{model: $model, messages: [{role: "user", content: $content}]}')" \
  | jq -r '.choices[0].message.content // .error.message // .'
