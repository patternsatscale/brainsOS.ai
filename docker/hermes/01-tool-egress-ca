#!/bin/sh
set -e

# ==============================================================================
# brainsOS: Tool Egress Proxy CA Trust Boot Hook
# Automatically trusts mitmproxy's root certificate authority on boot
# so curl, Python (requests, httpx, urllib), Node, etc. trust intercepted
# outbound HTTPS traffic without disabling TLS verification.
# ==============================================================================

# Ensure bind-mounted /opt/data state directory is writable by rootless hermes (10001:10001) (#382, #400)
if [ -d /opt/data ]; then
    chown 10001:10001 /opt/data 2>/dev/null || true
    for sub in sessions cron skills logs state plans pairing memories cache; do
        mkdir -p "/opt/data/${sub}" 2>/dev/null || true
        chown 10001:10001 "/opt/data/${sub}" 2>/dev/null || true
    done
fi

MITMPROXY_CA_CERT="/etc/ssl/mitmproxy/mitmproxy-ca-cert.pem"
TARGET_CERT="/usr/local/share/ca-certificates/mitmproxy-ca.crt"

# Wait up to 10 seconds for mitmproxy CA cert if proxy is still generating it
for i in $(seq 1 10); do
    if [ -f "${MITMPROXY_CA_CERT}" ]; then
        break
    fi
    sleep 1
done

if [ -f "${MITMPROXY_CA_CERT}" ]; then
    mkdir -p /usr/local/share/ca-certificates
    cp "${MITMPROXY_CA_CERT}" "${TARGET_CERT}"
    chmod 644 "${TARGET_CERT}"
    update-ca-certificates >/dev/null 2>&1 || true
fi

# ==============================================================================
# brainsOS: Hermes Dashboard Verified Reverse-Proxy Token Gate (#334, #400)
# Caddy enforces Authentik admin forward_auth at /runner* and injects a shared
# X-Hermes-Proxy-Token / X-Runner-Token header. Reject any direct container access
# that lacks a verified proxy token (fail closed).
# ==============================================================================
if [ -f /opt/hermes/hermes_cli/web_server.py ]; then
    PYTHON_BIN="/opt/hermes/.venv/bin/python"
    [ -x "${PYTHON_BIN}" ] || PYTHON_BIN="python3"
    "${PYTHON_BIN}" - << 'PYEOF'
import re
import textwrap
from pathlib import Path

path = Path("/opt/hermes/hermes_cli/web_server.py")
text = path.read_text(encoding="utf-8")
marker = "BRAINSOS_VERIFIED_PROXY_TOKEN_MIDDLEWARE"
if marker not in text:
    middleware_snippet = textwrap.dedent("""
        # BRAINSOS_VERIFIED_PROXY_TOKEN_MIDDLEWARE
        def _brainsos_verify_proxy_token(headers) -> tuple[bool, int]:
            import hmac as _hmac
            import os as _os
            proxy_secret = (_os.environ.get("HERMES_DASHBOARD_PROXY_TOKEN") or "").strip()
            runner_secret = (_os.environ.get("RUNNER_AUTH_TOKEN") or "").strip()
            if not proxy_secret and not runner_secret:
                return False, 503
            hdr_proxy = (headers.get("x-hermes-proxy-token") or "").strip()
            hdr_runner = (headers.get("x-runner-token") or "").strip()
            if proxy_secret and hdr_proxy and _hmac.compare_digest(hdr_proxy, proxy_secret):
                return True, 200
            if runner_secret and hdr_runner and _hmac.compare_digest(hdr_runner, runner_secret):
                if not proxy_secret or _hmac.compare_digest(proxy_secret, runner_secret):
                    return True, 200
            if not proxy_secret and runner_secret and hdr_proxy and _hmac.compare_digest(hdr_proxy, runner_secret):
                return True, 200
            return False, 401

        def _brainsos_attach_proxy_gate(app_obj):
            from starlette.responses import JSONResponse as _JSONResponse

            @app_obj.middleware("http")
            async def _brainsos_proxy_token_middleware(request, call_next):
                ok, code = _brainsos_verify_proxy_token(request.headers)
                if not ok:
                    return _JSONResponse({"detail": "Unauthorized proxy access"}, status_code=code)
                return await call_next(request)

            return app_obj
    """).lstrip("\n")

    if re.search(r"^\s*def\s+create_app\s*\(", text, re.MULTILINE) and re.search(r"\breturn\s+app\b", text):
        text = re.sub(
            r"(^\s*def\s+create_app\s*\()",
            middleware_snippet + "\n\\1",
            text,
            count=1,
            flags=re.MULTILINE,
        )
        text = re.sub(r"\breturn\s+app\b", "return _brainsos_attach_proxy_gate(app)", text)
    elif re.search(r"^\s*app\s*=\s*FastAPI\s*\(", text, re.MULTILINE):
        text = text.rstrip() + "\n\n" + middleware_snippet + "\n_brainsos_attach_proxy_gate(app)\n"
    else:
        raise RuntimeError(f"Unsupported web_server.py structure in {path}; refusing to leave dashboard unauthenticated")

    path.write_text(text, encoding="utf-8")

written = path.read_text(encoding="utf-8")
if marker not in written or "_brainsos_attach_proxy_gate(" not in written:
    raise RuntimeError(f"Post-write verification failed for {path}")
PYEOF
fi
