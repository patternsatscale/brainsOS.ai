#!/bin/sh
set -e

# ==============================================================================
# Project Titan: In-Transit Caddy PKI Trust Boot Hook
# Automatically trusts Caddy's internal root certificate authority on boot
# so Go (GitHub CLI), Git (libcurl), curl, and Python seamlessly trust
# https://github-proxy.titan.local without disabling TLS verification.
# ==============================================================================

CADDY_ROOT_CERT="/etc/ssl/caddy/caddy/pki/authorities/local/root.crt"
TARGET_CERT="/usr/local/share/ca-certificates/caddy-root.crt"

if [ -f "${CADDY_ROOT_CERT}" ]; then
    mkdir -p /usr/local/share/ca-certificates
    cp "${CADDY_ROOT_CERT}" "${TARGET_CERT}"
    chmod 644 "${TARGET_CERT}"
    update-ca-certificates >/dev/null 2>&1 || true
fi
