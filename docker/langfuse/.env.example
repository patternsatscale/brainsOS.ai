# ==============================================================================
# brainsOS: Langfuse Standalone Environment Configuration Template (v4.38.0)
# Used by scripts/setup/setup-langfuse.sh to initialize local or remote Langfuse instances
# ==============================================================================

# Web & Ingress Port
LANGFUSE_PORT=3001

# Public URL for browser authentication callbacks (e.g. http://localhost:3001 or https://langfuse.brainsos.local)
NEXTAUTH_URL=https://langfuse.local.brainsos.ai

# Native Authentik OIDC Single Sign-On
AUTH_CUSTOM_CLIENT_ID=langfuse-trace
AUTH_CUSTOM_CLIENT_SECRET=brainsos_langfuse_secret
AUTH_CUSTOM_ISSUER=https://local.brainsos.ai/application/o/langfuse
AUTH_CUSTOM_NAME="brainsOS SSO"
AUTH_CUSTOM_ALLOW_ACCOUNT_LINKING=true
AUTH_CUSTOM_FETCH_USERINFO=true
AUTH_DISABLE_USERNAME_PASSWORD=true

# Security Secrets (Must be consistent across container restarts)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
SALT=

# 256-bit Encryption Key for API credentials (must be exactly 64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Dedicated Langfuse PostgreSQL Database
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=brainsos_langfuse_secret_change_me
LANGFUSE_DB_PORT=5433
LANGFUSE_DB_DATA_DIR=./data/telemetry/postgres

# ClickHouse OLAP Columnar Store
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_CLICKHOUSE_DATA_DIR=./data/telemetry/clickhouse

# Redis Ingestion Queue
REDIS_AUTH=myredissecret
LANGFUSE_REDIS_DATA_DIR=./data/telemetry/redis

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_MINIO_DATA_DIR=./data/telemetry/minio

# Declarative Auto-Initialization (Zero-Click Project & Key Provisioning)
LANGFUSE_INIT_ORG_ID=brainsos
LANGFUSE_INIT_ORG_NAME="brainsOS"
LANGFUSE_INIT_PROJECT_ID=brainsos
LANGFUSE_INIT_PROJECT_NAME="brainsOS Fleet"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@brainsos.local
LANGFUSE_INIT_USER_NAME="brainsOS Admin"
LANGFUSE_INIT_USER_PASSWORD=brainsos_admin_password_change_me

# Disable external telemetry phoning home to Langfuse cloud
TELEMETRY_ENABLED=false

# Migration write mode (dual writes to PostgreSQL and ClickHouse, enabling REST traces/sessions APIs)
LANGFUSE_MIGRATION_V4_WRITE_MODE=dual
