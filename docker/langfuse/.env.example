# ==============================================================================
# Project Titan: Langfuse Standalone Environment Configuration Template
# Used by scripts/setup-langfuse.sh to initialize local or remote Langfuse instances
# ==============================================================================

# Web & Ingress Port
LANGFUSE_PORT=3001

# Public URL for browser authentication callbacks (e.g. http://localhost:3001 or http://langfuse.titan.local:3001)
NEXTAUTH_URL=http://localhost:3001

# Security Secrets (Must be consistent across container restarts)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
SALT=

# 256-bit Encryption Key for API credentials (must be exactly 64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Dedicated Langfuse PostgreSQL Database
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=titan_langfuse_secret_change_me
LANGFUSE_DB_DATA_DIR=./data/langfuse_db

# Disable external telemetry phoning home to Langfuse cloud
TELEMETRY_ENABLED=false
