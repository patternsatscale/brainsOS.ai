# ==============================================================================
# brainsOS - Environment Configuration Template
# Aligned with the BRAINS L1-L7 Reference Architecture (brainsOS.ai)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ==============================================================================
# Master Appliance Identity & Core Credentials
# ==============================================================================
BRAINSOS_ADMIN_USERNAME=admin
BRAINSOS_ADMIN_EMAIL=admin@brainsos.local
BRAINSOS_ADMIN_PASSWORD=brainsos_admin_password_change_me

# ==============================================================================
# L1 & L2: Hardware, Host & Container Virtualization
# User/Group IDs and host bind-mount storage paths
# ==============================================================================
PUID=1000
PGID=1000

# Storage & Bind-Mount Paths
# Absolute or relative path to the runtime data directory / private fleet repository
# Local mode (default): ./data
# Decoupled mode (external private repo): /path/to/my-fleet-data (e.g., /Users/pats/Development/project_mJ)
BRAINSOS_DATA_DIR=./data

# Optional granular sub-directory overrides (leave commented to inherit from BRAINSOS_DATA_DIR):
# BRAINSOS_AGENT_MEMORIES_DIR=./data/agent_memories
# BRAINSOS_AGENT_WORKSPACES_DIR=./data/agent_workspaces
# BRAINSOS_COMMS_DIR=./data/comms
# BRAINSOS_CONTROL_PLANE_DIR=./data/control_plane
# BRAINSOS_TELEMETRY_DIR=./data/telemetry
# BRAINSOS_RUNNERS_DIR=./data/runners
# BRAINSOS_SOULS_DIR=./data/souls
# BRAINSOS_SETTINGS_DIR=./data/settings
# BRAINSOS_AGENT_APPS_DIR=./data/agent_apps
# LITELLM_DB_DATA_DIR=./data/control_plane/litellm_db

# ==============================================================================
# L3: Host Inference Engine (vLLM / Ollama)
# Raw model weights running natively on host loopback (127.0.0.1:11434)
# ==============================================================================
OLLAMA_PORT=11434
INFERENCE_MODEL=gemma2:2b
BRAINSOS_CORE_MODEL=ollama_chat/llama3.2:3b

# Inference Context Window (Tokens)
# Safe default for 16GB macOS workstation: 4096 (prevents host memory pressure & OOM)
# High-capacity GX10 GB10 appliance: 32768 (automatically configured by setup-host.sh)
INFERENCE_NUM_CTX=4096

# ==============================================================================
# L4: Routing & Security Plane (LiteLLM Gateway & Database)
# Serializes hardware memory access (max_parallel_requests: 1) and enforces budgets
# ==============================================================================
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-brainsos-mock-key
PROXY_ADMIN_ID=admin

# LiteLLM Dedicated Control Plane Database (PostgreSQL)
# Strictly bound to loopback; unreachable by agent containers
LITELLM_DB_PORT=5432
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm_db_password_change_me
DATABASE_URL=postgresql://litellm:litellm_db_password_change_me@127.0.0.1:5432/litellm

# ==============================================================================
# L5: Memory & Tool Plane
# Human-auditable OKF Markdown storage and tool integrations
# ==============================================================================
# Optional Web Search Tool Integration
WEB_SEARCH_API_KEY=

# ==============================================================================
# L6: Agent Plane & Multi-Agent Fleet Keys
# Dedicated virtual keys and budgets provisioned in LiteLLM DB
# Inbound Fleet Agent API Keys (Hermes API Platform - ports 8642, 8643, 8644)
# Authenticates callers (Webhooks, IDE, external services) -> api.<agent>.brainsos.local
HERMES_API_TERRASTELLA_KEY=hermes_api_terrastella_key_change_me
HERMES_API_MARVIN_KEY=hermes_api_marvin_key_change_me
HERMES_API_BAWTFORD_KEY=hermes_api_bawtford_key_change_me

# Outbound LiteLLM Virtual Keys (LiteLLM Control Plane Gateway - port 4000)
# Authenticates agent units -> http://proxy.local:4000/v1 for model inference
TERRASTELLA_LITELLM_KEY=terrastella_litellm_key_change_me     # Terrastella (Primary Operations Agent)
MARVIN_LITELLM_KEY=marvin_litellm_key_change_me             # Marvin (Sports Analytics Agent)
BAWTFORD_LITELLM_KEY=bawtford_litellm_key_change_me         # Bawtford (Creative Director Agent)

# Agent Git & GitHub CLI Credentials (Fine-Grained PAT scoped to dedicated repo)
# Injected in-transit via Caddy proxy (github-proxy.brainsos.local); never enters agent containers
GITHUB_TOKEN_CINDY=
# Auto-derived as base64(x-access-token:$GITHUB_TOKEN_CINDY) for Git Smart HTTP
GITHUB_BASIC_AUTH_CINDY=

# Agent Web Dashboard Local Basic Auth (defaults to BRAINSOS_ADMIN_USERNAME / BRAINSOS_ADMIN_PASSWORD)
# HERMES_DASHBOARD_USER=admin
# HERMES_DASHBOARD_PASSWORD=

# Default ports for standalone Hermes instances
HERMES_PORT=8642
HERMES_DASHBOARD_PORT=9119

# ==============================================================================
# L7: Communications & UX Ingress Plane
# Caddy reverse proxy, Signal/Telegram messaging, and Webmail / IDE UIs
# ==============================================================================
BRAINSOS_DOMAIN=brainsos.local

# Local / Internal Webmail Domain (for Caddy, SOGo UI, and local container mailboxes)
# Used for private development or host loopback routing (e.g. mail.local.brainsos.ai)
# Distinct from public cloud ingress domains receiving mail from external services like Gmail.
# BRAINSOS_MAIL_DOMAIN=mail.brainsos.local

# Split-Horizon DNS & ACME DNS-01 Wildcard SSL
# Set to your public domain to enable public Let's Encrypt wildcard certificate via Route 53 DNS-01
# BRAINSOS_DOMAIN=brainsos.example.com
ACME_DNS_PROVIDER=
ACME_EMAIL=operator@example.com

# AWS Credentials for Platform Cloud Infrastructure & ACME DNS-01 Challenge
# If AWS CLI is configured on the host (~/.aws/credentials & ~/.aws/config),
# SST and Caddy automatically resolve credentials. Leave empty to use ~/.aws.
BRAINSOS_INFRA_AWS_ACCESS_KEY_ID=
BRAINSOS_INFRA_AWS_SECRET_ACCESS_KEY=
BRAINSOS_INFRA_AWS_REGION=us-east-1

# Ingress Reverse Proxy Ports (Caddy Gateway)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Internal Service Ports & Operator IDE
# Authenticated L7 Operator Console (editor.brainsos.local / code.brainsos.local)
CODE_SERVER_PORT=8443
CODE_SERVER_AUTH=none
# Optional: Custom Operator IDE Password (defaults to BRAINSOS_ADMIN_PASSWORD)
# CODE_SERVER_PASSWORD=
# BRAINSOS_CODE_SERVER_CONFIG=./data/control_plane/vscode_config
# BRAINSOS_CODE_SERVER_DATA=./data/control_plane/vscode_data
OPERATOR_LITELLM_KEY=operator_litellm_key_change_me
OPERATOR_USER=operator

# Messaging Gateway Configurations (Signal Private Operator Backchannel)
SIGNAL_ACCOUNT=+15551234567                  # Registered/linked Signal phone number in E.164 format
SIGNAL_ALLOWED_USERS=+15551234567            # Comma-separated authorized operator phone numbers or UUIDs
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ==============================================================================
# Cross-Cutting: Benchmarking, Evaluation & Observability Plane
# Langfuse OpenTelemetry trace collection & NVIDIA DGX Telemetry
# ==============================================================================
LANGFUSE_PORT=3001
LANGFUSE_HOST=http://langfuse.brainsos.local:3001
LANGFUSE_AUTO_START=false

# Remote Workstation LAN IP (if running Langfuse remotely on another laptop)
LANGFUSE_HOST_IP=

# Observability Keys (Langfuse Web UI -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Base64-encoded Authorization header: Basic <base64(public_key:secret_key)>
LANGFUSE_OTEL_AUTH=

# Langfuse Distributed Stack Cryptographic Secrets (auto-generated by make env)
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# Langfuse v4 Declarative Auto-Provisioning & Admin Credentials
# (Admin email & password inherit automatically from BRAINSOS_ADMIN_EMAIL / BRAINSOS_ADMIN_PASSWORD)
LANGFUSE_INIT_ORG_ID=brainsos
LANGFUSE_INIT_ORG_NAME="brainsOS"
LANGFUSE_INIT_PROJECT_ID=brainsos
LANGFUSE_INIT_PROJECT_NAME="brainsOS Fleet"
LANGFUSE_INIT_USER_NAME="brainsOS Admin"
LANGFUSE_MIGRATION_V4_WRITE_MODE=dual

# Tool Egress Gateway & Inspection Proxy (mitmproxy / mitmweb)
# Web inspection password defaults to BRAINSOS_ADMIN_PASSWORD
TOOL_EGRESS_WEB_PORT=8081
# TOOL_EGRESS_WEB_PASSWORD=

# ==============================================================================
# L7: Communications Plane: Internal Email & SOGo Subsystem
# Lightweight ARM64 Mail Engine (Postfix + Dovecot) & SOGo Groupware Client
# Storage strictly isolated under ${BRAINSOS_COMMS_DIR}/email
# Note: Admin & Operator mailboxes automatically inherit BRAINSOS_ADMIN_PASSWORD
# ==============================================================================
SOGO_DB_PASSWORD=sogo_db_password_change_me
MAIL_SMTP_PORT=10025
MAIL_IMAP_PORT=10143
TERRASTELLA_MAIL_PASSWORD=terrastella_mail_password_change_me
BAWTFORD_MAIL_PASSWORD=bawtford_mail_password_change_me
MARVIN_MAIL_PASSWORD=marvin_mail_password_change_me
PING_MAIL_PASSWORD=ping_mail_password_change_me
CLAUDE_MAIL_PASSWORD=claude_mail_password_change_me
GPT_MAIL_PASSWORD=gpt_mail_password_change_me

# ==============================================================================
# L7: External Email Ingress (AWS SES, S3, SQS & brainsOS-mail)
# Multi-environment ingress pipeline for OSX laptop testing & DGX appliance
# ==============================================================================


# Stage for multi-environment isolation (osx for laptop testing, dgx for production box)
BRAINSOS_STAGE=osx

# Public Cloud Email Ingress Domain (where external services like Gmail send mail to AWS SES)
# Must be a public domain or subdomain hosted in AWS Route 53 (e.g. osx.brainsos.ai or brainsos.ai).
# Public internet MTAs require Route 53 MX records pointing to SES (not private loopback 127.0.0.1).
BRAINSOS_EMAIL_DOMAIN=osx.example.com
# BRAINSOS_EXTERNAL_EMAIL_DOMAIN is supported as an explicit alias for BRAINSOS_EMAIL_DOMAIN
# BRAINSOS_EXTERNAL_EMAIL_DOMAIN=osx.example.com

INGRESS_QUEUE_URL=
INGRESS_BUCKET_NAME=
# INGRESS_S3_BUCKET is supported as an alias for INGRESS_BUCKET_NAME
INGRESS_S3_BUCKET=
INGRESS_AWS_ACCESS_KEY_ID=
ALLOWED_EXTERNAL_SENDERS=patternsatscale@gmail.com

# ==============================================================================
# L7: Unified Portal, Authentik SSO & Hermes WebUI
# Bespoke Thin-Spine Portal Shell, Authentik Zero-Trust SSO & Hermes Config UI
# Note: Authentik bootstrap superuser automatically inherits BRAINSOS_ADMIN_PASSWORD & BRAINSOS_ADMIN_EMAIL
# ==============================================================================
AUTHENTIK_PORT=9002
AUTHENTIK_SECRET_KEY=authentik_secret_key_change_me
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=authentik_db_password_change_me
AUTHENTIK_BOOTSTRAP_TOKEN=authentik_bootstrap_token_change_me
AUTHENTIK_COOKIE_DOMAIN=local.brainsos.ai
HERMES_RUNNER_WEB_PORT=8787


