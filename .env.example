# ==============================================================================
# Project Titan - Environment Configuration Template
# Aligned with the Titan L1-L7 Reference Architecture
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ==============================================================================
# L1 & L2: Hardware, Host & Container Virtualization
# User/Group IDs and host bind-mount storage paths
# ==============================================================================
PUID=1000
PGID=1000

# Storage & Bind-Mount Paths
# Development convention (macOS & standard clones): ./data/...
# Production appliance convention (ASUS GX10 NVMe mount): /data/titan/...
TITAN_DATA_DIR=./data/memories
TITAN_WORKSPACE_DIR=./data/workspace
LITELLM_DB_DATA_DIR=./data/litellm_db

# ==============================================================================
# L3: Host Inference Engine (vLLM / Ollama)
# Raw model weights running natively on host loopback (127.0.0.1:11434)
# ==============================================================================
OLLAMA_PORT=11434
INFERENCE_MODEL=gemma2:2b

# Inference Context Window (Tokens)
# Safe default for 16GB macOS workstation: 4096 (prevents host memory pressure & OOM)
# High-capacity GX10 GB10 appliance: 32768 (automatically configured by setup-host.sh)
INFERENCE_NUM_CTX=4096

# ==============================================================================
# L4: Routing & Security Plane (LiteLLM Gateway & Database)
# Serializes hardware memory access (max_parallel_requests: 1) and enforces budgets
# ==============================================================================
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-titan-master-key-admin-change-me

# LiteLLM Dedicated Control Plane Database (PostgreSQL)
# Strictly bound to loopback; unreachable by agent containers
LITELLM_DB_PORT=5432
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=titan_litellm_secret_change_me
DATABASE_URL=postgresql://litellm:titan_litellm_secret_change_me@127.0.0.1:5432/litellm

# ==============================================================================
# L5: Memory & Tool Plane
# Human-auditable OKF Markdown storage and tool integrations
# ==============================================================================
# Optional Web Search Tool Integration
WEB_SEARCH_API_KEY=

# ==============================================================================
# L6: Agent Plane & Multi-Agent Fleet Keys
# Dedicated virtual keys and budgets provisioned in LiteLLM DB
# ==============================================================================
# Global / Primary Agent API Key (Min 16 chars required by upstream)
API_SERVER_KEY=sk-titan-hermes-api-secret-change-me

# Dedicated Virtual Keys for Scalable Agent Units
HERMES_LITELLM_KEY=sk-titan-hermes-virtual-key-change-me
HERMES_FOOTBALL_DAN_KEY=sk-titan-football-dan-virtual-key
HERMES_CINDY_PAWFORD_KEY=sk-titan-cindy-pawford-virtual-key
HERMES_CINDY_LITELLM_KEY=sk-titan-cindy-virtual-key

# Agent Git & GitHub CLI Credentials (Fine-Grained PAT scoped to dedicated repo)
# Injected in-transit via Caddy proxy (github-proxy.titan.local); never enters agent containers
GITHUB_TOKEN_CINDY=
# Auto-derived as base64(x-access-token:$GITHUB_TOKEN_CINDY) for Git Smart HTTP
GITHUB_BASIC_AUTH_CINDY=

# Agent Web Dashboard Local Basic Auth
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=titan_admin_secret_change_me

# Default ports for standalone Hermes instances
HERMES_PORT=8642
HERMES_DASHBOARD_PORT=9119

# ==============================================================================
# L7: Communications & UX Ingress Plane
# Caddy reverse proxy, Signal/Telegram messaging, and SilverBullet PKM UI
# ==============================================================================
TITAN_DOMAIN=titan.local

# Ingress Reverse Proxy Ports (Caddy Gateway)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Internal Service Ports
SILVERBULLET_PORT=3000          # Memory Plane PKM Web UI (memory.titan.local)

# Messaging Gateway Configurations
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Per-Agent Telegram Bot Tokens & Whitelists
TELEGRAM_BOT_TOKEN_PRIMARY=
TELEGRAM_ALLOWED_USERS_PRIMARY=

TELEGRAM_BOT_TOKEN_FOOTBALL_DAN=
TELEGRAM_ALLOWED_USERS_FOOTBALL_DAN=

TELEGRAM_BOT_TOKEN_CINDY=
TELEGRAM_ALLOWED_USERS_CINDY=

# ==============================================================================
# Cross-Cutting: Benchmarking, Evaluation & Observability Plane
# Langfuse OpenTelemetry trace collection & NVIDIA DGX Telemetry
# ==============================================================================
LANGFUSE_PORT=3001
LANGFUSE_HOST=http://langfuse.titan.local:3001
LANGFUSE_AUTO_START=false

# Remote Workstation LAN IP (if running Langfuse remotely on another laptop)
LANGFUSE_HOST_IP=

# Observability Keys (Langfuse Web UI -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Base64-encoded Authorization header: Basic <base64(public_key:secret_key)>
LANGFUSE_OTEL_AUTH=
