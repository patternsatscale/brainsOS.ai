# ==============================================================================
# Project Titan - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# User / Group IDs for consistent volume file permissions (default: 1000:1000)
PUID=1000
PGID=1000

# Host Storage Bind-Mount Paths
# ------------------------------------------------------------------------------
# Default convention (macOS development & standard repository setup):
#   Paths are relative to the project root: ./data/memories, ./data/workspace, etc.
# Production appliance convention (ASUS Ascent GX10):
#   If a dedicated NVMe partition is mounted at /data/titan, set absolute paths:
#   TITAN_DATA_DIR=/data/titan/memories
#   TITAN_WORKSPACE_DIR=/data/titan/workspace
#   LITELLM_DB_DATA_DIR=/data/titan/litellm_db
# ------------------------------------------------------------------------------

# Memory Plane: Host Storage Bind-Mount for OKF Markdown Memories
TITAN_DATA_DIR=./data/memories

# Agent Plane: Host Storage Bind-Mount for Hermes Agent Runtime Workspace (Tools, Caches, Signal)
TITAN_WORKSPACE_DIR=./data/workspace

# Ingress Ports
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Internal Service Ports (Exposed to Ingress / Localhost)
HERMES_PORT=8642
HERMES_DASHBOARD_PORT=9119
LITELLM_PORT=4000
SILVERBULLET_PORT=3000
OLLAMA_PORT=11434

# Hermes Dashboard Authentication (Local Basic Auth)
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=titan_admin_secret_change_me

# Messaging Gateway: Signal (via companion signal-cli daemon)
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=

# Messaging Gateway: Telegram (via bot token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Ingress Domain Suffix (default: titan.local)
TITAN_DOMAIN=titan.local

# LiteLLM Keys
# Master Key: Administrative control, key generation, and emergency revocation
LITELLM_MASTER_KEY=sk-titan-master-key-admin-change-me
# Hermes Virtual Key: Provisioned exclusively for the Hermes agent
HERMES_LITELLM_KEY=sk-titan-hermes-virtual-key-change-me

# LiteLLM Dedicated Control Plane Database (PostgreSQL)
# Host storage bind-mount for LiteLLM PostgreSQL persistence
# Local macOS testing: ./data/litellm_db
# ASUS GX10 production: /data/titan/litellm_db
LITELLM_DB_DATA_DIR=./data/litellm_db
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=titan_litellm_secret_change_me
LITELLM_DB_PORT=5432
DATABASE_URL=postgresql://litellm:titan_litellm_secret_change_me@127.0.0.1:5432/litellm

# Default Inference Model (Ollama)
# Minimal, lightweight model for initial verification
INFERENCE_MODEL=gemma2:2b

# Inference Context Window (Tokens)
# Safe default for 16GB macOS workstation: 4096 (prevents host memory pressure & OOM)
# High-capacity GX10 GB10 appliance: 32768 (automatically configured by setup-host.sh)
INFERENCE_NUM_CTX=4096

# Optional Hermes External Integrations
WEB_SEARCH_API_KEY=
