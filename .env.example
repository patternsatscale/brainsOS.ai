# ==============================================================================
# Project Titan - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & PERMISSIONS
# ------------------------------------------------------------------------------
# User / Group IDs for consistent volume file permissions (default: 1000:1000)
PUID=1000
PGID=1000

# Ingress Domain Suffix (default: titan.local)
TITAN_DOMAIN=titan.local

# ------------------------------------------------------------------------------
# 2. NETWORKING & PORTS
# ------------------------------------------------------------------------------
# Ingress Reverse Proxy Ports (Caddy Gateway)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Internal Service Ports (Exposed to Ingress / Localhost)
SILVERBULLET_PORT=3000          # Memory Plane PKM Web UI (memory.titan.local)
LANGFUSE_PORT=3001              # Observability Platform Web & OTel (langfuse.titan.local)
LITELLM_PORT=4000               # Control Plane Gateway (proxy.titan.local)
LITELLM_DB_PORT=5432            # LiteLLM PostgreSQL persistence database
HERMES_PORT=8642                # Hermes OpenAI-compatible API platform (api.hermes.titan.local)
HERMES_DASHBOARD_PORT=9119      # Hermes Agent Web Dashboard (hermes.titan.local)
OLLAMA_PORT=11434               # Host Ollama Inference Engine (strictly loopback)

# Remote Workstation LAN IP (if running Langfuse remotely on another laptop)
LANGFUSE_HOST_IP=

# ------------------------------------------------------------------------------
# 3. WEB UI & DASHBOARD PASSWORDS
# ------------------------------------------------------------------------------
# Hermes Agent Web Dashboard (:9119) Local Basic Auth
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=titan_admin_secret_change_me

# ------------------------------------------------------------------------------
# 4. API KEYS & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Hermes OpenAI-Compatible API Platform Authentication (Port 8642)
# Min 16 chars required by upstream startup guard; use: openssl rand -hex 32
API_SERVER_KEY=sk-titan-hermes-api-secret-change-me

# LiteLLM Gateway Keys (:4000)
# Master Key: Administrative control, model management, and emergency revocation
LITELLM_MASTER_KEY=sk-titan-master-key-admin-change-me
# Hermes Virtual Key: Provisioned exclusively for the Hermes agent
HERMES_LITELLM_KEY=sk-titan-hermes-virtual-key-change-me

# Observability Keys (Langfuse Web UI -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Base64-encoded Authorization header: Basic <base64(public_key:secret_key)>
# Auto-computed by start-control-plane.sh or ./scripts/setup-langfuse.sh keys
LANGFUSE_OTEL_AUTH=

# Optional Web Search Tool Integration
WEB_SEARCH_API_KEY=

# Messaging Gateways
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ------------------------------------------------------------------------------
# 5. STORAGE & BIND-MOUNT PATHS
# ------------------------------------------------------------------------------
# Development convention (macOS & standard clones): ./data/...
# Production appliance convention (ASUS GX10 NVMe mount): /data/titan/...
TITAN_DATA_DIR=./data/memories
TITAN_WORKSPACE_DIR=./data/workspace
LITELLM_DB_DATA_DIR=./data/litellm_db

# ------------------------------------------------------------------------------
# 6. INFERENCE & CONTROL PLANE DATABASE
# ------------------------------------------------------------------------------
# Default Local Inference Model (Ollama)
INFERENCE_MODEL=gemma2:2b

# Inference Context Window (Tokens)
# Safe default for 16GB macOS workstation: 4096 (prevents host memory pressure & OOM)
# High-capacity GX10 GB10 appliance: 32768 (automatically configured by setup-host.sh)
INFERENCE_NUM_CTX=4096

# LiteLLM Dedicated Control Plane Database (PostgreSQL)
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=titan_litellm_secret_change_me
DATABASE_URL=postgresql://litellm:titan_litellm_secret_change_me@127.0.0.1:5432/litellm

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY PLANE CONFIGURATION
# ------------------------------------------------------------------------------
# Automatically start local Langfuse stack on control plane boot (default: false)
# Set to true to launch Langfuse locally; keep false when running on a separate laptop
LANGFUSE_AUTO_START=false

# Langfuse Service Base URL (resolves to local container or remote laptop)
LANGFUSE_HOST=http://langfuse.titan.local:3001
